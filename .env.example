# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_USER=cli_login_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cli_login

# Host is "db" (the docker-compose service name), not "localhost" — the
# app container reaches Postgres over the compose network. If you're
# running `go test`/`go run` directly on the host (not in Docker), use
# localhost:5432 instead (docker-compose publishes the db port there).
DATABASE_URL=postgres://cli_login_user:changeme@db:5432/cli_login?sslmode=disable

# --- Auth / session policy (internal/config) ---

# Consecutive failed logins allowed before an account is locked.
MAX_FAILED_ATTEMPTS=5

# How long an account stays locked after hitting MAX_FAILED_ATTEMPTS.
LOCKOUT_DURATION_MINUTES=15

# How long a session token stays valid after being issued.
SESSION_TIMEOUT_MINUTES=30
