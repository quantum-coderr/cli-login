# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_USER=cli_login_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cli_login

# Host is "db" (the docker-compose service name), not "localhost". The
# app container reaches Postgres over the compose network by that name.
# If you're running go test or go run directly on the host instead of in
# Docker, use localhost:5432 instead, docker-compose publishes the db
# port there for exactly that reason.
DATABASE_URL=postgres://cli_login_user:changeme@db:5432/cli_login?sslmode=disable

# --- Auth / session policy (internal/config) ---

# Consecutive failed logins allowed before an account is locked.
MAX_FAILED_ATTEMPTS=5

# How long an account stays locked after hitting MAX_FAILED_ATTEMPTS.
LOCKOUT_DURATION_MINUTES=15

# How long a session token stays valid after being issued.
SESSION_TIMEOUT_MINUTES=30

# Shortest password RegisterUser will accept.
MIN_PASSWORD_LENGTH=8

# --- Migrations ---

# Where main.go looks for migration files. The default of "migrations"
# is correct both when running locally from the repo root and inside the
# container (the Dockerfile copies the migrations folder to ./migrations
# next to the binary), so this normally never needs to be set. Listed
# here mainly so it's not a hidden default if you ever do need to change it.
MIGRATIONS_DIR=migrations
